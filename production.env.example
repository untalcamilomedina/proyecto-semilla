# ───────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT VARIABLES
# Copy to production.env and fill in real values
# NEVER commit production.env to git!
# ───────────────────────────────────────────────────────────────────

# ── Django ──
DJANGO_SECRET_KEY=CHANGE-ME-run-python-c-import-secrets-secrets-token-urlsafe-50
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=false
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
PROJECT_NAME=Proyecto Semilla

# Clave dedicada para cifrado de campos en BD (OBLIGATORIA en prod:
# si se deriva de SECRET_KEY, rotar SECRET_KEY deja ilegibles los datos).
FIELD_ENCRYPTION_KEY=CHANGE-ME-long-random-string-dedicated-to-field-encryption

# Clave dedicada para firmar JWT (permite rotar SECRET_KEY sin invalidar tokens).
JWT_SIGNING_KEY=CHANGE-ME-long-random-string-dedicated-to-jwt

# Token Bearer para scrapear /metrics desde Prometheus (vacío = endpoint cerrado).
METRICS_TOKEN=CHANGE-ME-metrics-scrape-token

# ── Database ──
POSTGRES_USER=app_prod
POSTGRES_PASSWORD=CHANGE-ME-strong-random-password
POSTGRES_DB=proyecto_semilla
DATABASE_URL=postgresql://app_prod:CHANGE-ME@postgres:5432/proyecto_semilla

# ── Redis ──
REDIS_PASSWORD=CHANGE-ME-strong-random-password
REDIS_URL=redis://:CHANGE-ME@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE-ME@redis:6379/1

# ── MinIO / S3 ──
MINIO_ROOT_USER=CHANGE-ME-minio-admin
MINIO_ROOT_PASSWORD=CHANGE-ME-strong-random-password
S3_ACCESS_KEY=CHANGE-ME-minio-admin
S3_SECRET_KEY=CHANGE-ME-strong-random-password
S3_BUCKET_NAME=app-media
S3_ENDPOINT_URL=http://minio:9000

# ── CORS / CSRF (frontend en dominio distinto al API) ──
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Stripe (optional — required for billing) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false

# ── Email ──
# ANYMAIL_API_KEY=your-sendgrid-key
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Sentry (optional) ──
# SENTRY_DSN=https://abc123@sentry.io/456

# ── Frontend ──
FRONTEND_URL=https://yourdomain.com
DOMAIN_BASE=yourdomain.com

# ── Modules ──
ENABLE_LMS=true
ENABLE_COMMUNITY=true
ENABLE_MCP=true
ENABLE_CRM=false
