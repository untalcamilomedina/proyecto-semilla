# ── Django ──────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=CHANGE-ME-generate-with-python-c-import-secrets-secrets-token-urlsafe-50
DEBUG=true
PROJECT_NAME=Proyecto Semilla

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/proyecto_semilla

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── MinIO (S3-compatible) ───────────────────────────────────
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=media
S3_ENDPOINT_URL=http://minio:9000

# ── Email (Mailpit) ────────────────────────────────────────
EMAIL_HOST=mailpit
EMAIL_PORT=1025

# ── Frontend ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3010
DOMAIN_BASE=localhost

# ── Optional Modules ───────────────────────────────────────
ENABLE_LMS=true
ENABLE_COMMUNITY=true
ENABLE_MCP=true

# ── Multitenancy ───────────────────────────────────────────
MULTITENANT_MODE=schema

# ── Claves dedicadas (recomendado definirlas también en dev) ──
# Cifrado de campos sensibles en BD (rotar SECRET_KEY no debe romper datos):
# FIELD_ENCRYPTION_KEY=CHANGE-ME-another-long-random-string
# Firma de JWT (separada del SECRET_KEY):
# JWT_SIGNING_KEY=CHANGE-ME-another-long-random-string
# Token Bearer para /metrics (vacío = cerrado fuera de DEBUG):
# METRICS_TOKEN=

# ── Stripe (leave empty for dev, required for billing in prod) ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_LIVE_MODE=false

# ── Sentry (optional) ──────────────────────────────────────
# SENTRY_DSN=
